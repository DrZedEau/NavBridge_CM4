  (text "CM pins: CAM1_D0_N/P = 115/117, CAM1_C_N/P = 127/129\n(CN2 pads 15/17/27/29). Add the same four global labels\non CN2 in the root sheet.\n\n100 R differential pairs, P/N not swapped. The 0 R links\nlet CAM1 take either this decoder or an FPC camera."
    (at 274.32 157.48 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "a3070b66-4056-5d56-93ef-38cfac05b7d8")
  )
